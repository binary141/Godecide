<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<definitions
    namespace="https://github.com/agilepro/dmn-tck"
    name="out-of-order"
    id="_out-of-order"
    xmlns="https://www.omg.org/spec/DMN/20230324/MODEL/"
    xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/"
    xmlns:dmndi="https://www.omg.org/spec/DMN/20230324/DMNDI/"
    xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/">

    <!-- INPUTS -->
    <inputData name="First Name" id="i_FirstName">
        <variable typeRef="string" name="First Name"/>
    </inputData>
    <inputData name="Last Name" id="i_LastName">
        <variable typeRef="string" name="Last Name"/>
    </inputData>
    <inputData name="Department" id="i_Department">
        <variable typeRef="string" name="Department"/>
    </inputData>

    <!-- DECISION 1: Greeting — depends on Full Name which is defined BELOW -->
    <decision name="Greeting" id="d_Greeting">
        <variable typeRef="string" name="Greeting"/>
        <informationRequirement id="_req_greeting_fullname">
            <requiredDecision href="#d_FullName"/>
        </informationRequirement>
        <informationRequirement id="_req_greeting_dept">
            <requiredInput href="#i_Department"/>
        </informationRequirement>
        <literalExpression>
            <text>"Welcome to " + Department + ", " + Full Name</text>
        </literalExpression>
    </decision>

    <!-- DECISION 2: Employee Tag — depends on Full Name which is defined BELOW -->
    <decision name="Employee Tag" id="d_EmployeeTag">
        <variable typeRef="string" name="Employee Tag"/>
        <informationRequirement id="_req_tag_fullname">
            <requiredDecision href="#d_FullName"/>
        </informationRequirement>
        <informationRequirement id="_req_tag_dept">
            <requiredInput href="#i_Department"/>
        </informationRequirement>
        <literalExpression>
            <text>Department + " | " + Full Name</text>
        </literalExpression>
    </decision>

    <!-- DECISION 3: Full Name — leaf decision, defined LAST but must evaluate FIRST -->
    <decision name="Full Name" id="d_FullName">
        <variable typeRef="string" name="Full Name"/>
        <informationRequirement id="_req_fullname_first">
            <requiredInput href="#i_FirstName"/>
        </informationRequirement>
        <informationRequirement id="_req_fullname_last">
            <requiredInput href="#i_LastName"/>
        </informationRequirement>
        <literalExpression>
            <text>First Name + " " + Last Name</text>
        </literalExpression>
    </decision>

</definitions>
